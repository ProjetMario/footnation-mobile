  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios",
    "export:android": "expo export --platform android",
    "test:core": "node --test tests/core.test.ts tests/team-calendar.test.ts",
    "test:calls": "vitest run",
    "test": "npm run check:native && npm run test:core && npm run test:calls && npm run test:release",
    "format": "prettier --write app src tests scripts *.json *.ts *.js",
    "format:check": "prettier --check app src tests scripts *.json *.ts *.js",
    "prebuild": "expo prebuild --no-install",
    "export:all": "expo export --platform all --output-dir dist-native",
    "check:native": "node scripts/check-native.cjs",
    "check:build-env": "node scripts/check-build-env.cjs",
    "test:release": "node --test scripts/release-preflight.test.cjs",
    "release:preflight": "node scripts/release-preflight.cjs",
    "release:verify": "node scripts/release-verify.cjs",
    "eas-build-pre-install": "node scripts/check-build-env.cjs",
    "pilot-launch": "node scripts/pilot-launch.mjs",
    "audit:ui": "node scripts/audit/start-ui.mjs",
    "audit:inventory": "node scripts/audit/inventory.mjs",
