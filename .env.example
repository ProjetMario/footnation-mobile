EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Vide : suivre les fournisseurs activés dans Supabase. false : masquer explicitement.
# Sur iOS, Google exige aussi Apple configuré et disponible.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=
EXPO_PUBLIC_APPLE_AUTH_ENABLED=
# Activer seulement après déploiement et validation du service d’envoi et des reçus.
EXPO_PUBLIC_NATIVE_PUSH_ENABLED=false
# Réception des erreurs : renseigner le projet Sentry puis activer sur une build preview.
EXPO_PUBLIC_ERROR_REPORTING_ENABLED=false
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=preview
# Variables de build uniquement. Ne jamais préfixer le jeton par EXPO_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Facultatif : URL HTTPS d’un tableau PostHog explicitement partagé pour intégration.
# Visible dans le bundle. Ne pas y placer de jeton privé ni de clé API.
EXPO_PUBLIC_POSTHOG_DASHBOARD_URL=
# Studio de montage : URL HTTPS de l’API, après activation du backend dédié.
# Vide : import, brouillons locaux et publication simple restent disponibles.
# Aucune clé de service ne doit être placée dans les variables Expo.
EXPO_PUBLIC_MEDIA_STUDIO_URL=
# Espace Supporters : false masque les entrées et bloque ses requêtes.
# À activer en production seulement après application de sa migration dédiée.
EXPO_PUBLIC_SUPPORTERS_ENABLED=true
