EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Activer après les migrations, la configuration des fournisseurs et la recette.
# Sur iOS, Google exige aussi Apple configuré et disponible.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
# Activer seulement après déploiement et validation du service d’envoi et des reçus.
EXPO_PUBLIC_NATIVE_PUSH_ENABLED=false
# Réception des erreurs : renseigner le projet Sentry puis activer sur une build preview.
EXPO_PUBLIC_ERROR_REPORTING_ENABLED=false
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=preview
# Variables de build uniquement. Ne jamais préfixer le jeton par EXPO_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Facultatif : URL HTTPS d’un tableau PostHog explicitement partagé pour intégration.
# Visible dans le bundle. Ne pas y placer de jeton privé ni de clé API.
EXPO_PUBLIC_POSTHOG_DASHBOARD_URL=
